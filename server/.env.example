# =========================================================
#  تنظیمات سرور Lika Ads
#  ---------------------------------------------------------
#  این فایل را کپی کنید و اسمش را بگذارید  .env
#  سپس مقدارها را پر کنید.
#
#  ⚠️ فایل .env هرگز نباید در گیت‌هاب قرار بگیرد (توکن ربات مثل رمز عبور است).
# =========================================================

# ---------- ۱) توکن ربات (اجباری) ----------
# از @BotFather می‌گیرید. چیزی شبیه:  1234567890:AAF...
BOT_TOKEN=

# ---------- ۲) آدرس اینترنتی مینی‌اپ (اجباری) ----------
# آدرسی که فایل‌های پوشه web روی آن بالا آمده‌اند. حتماً https باشد.
# اگر همین سرور فایل‌ها را سرو می‌کند، همان آدرس عمومی سرور را بگذارید.
WEBAPP_URL=

# ---------- ۳) چت دریافت سفارش‌ها (اجباری) ----------
# سفارش‌های جدید به این چت ارسال می‌شود؛ می‌تواند چت خودتان یا یک گروه تیمی باشد.
# برای پیدا کردن این عدد، در ربات دستور /id را بفرستید.
ADMIN_CHAT_ID=

# ---------- ۴) مدیران (اجباری) ----------
# آیدی عددی افرادی که اجازه دارند وضعیت سفارش‌ها را تغییر دهند.
# چند نفر را با کاما جدا کنید. با دستور /id در ربات پیدا می‌شود.
ADMIN_IDS=

# ---------- ۵) تنظیمات اختیاری ----------
# پورتی که سرور روی آن بالا می‌آید
PORT=3000

# محل فایل دیتابیس (فقط وقتی از SQLite استفاده می‌شود)
DB_PATH=./data/lika.db

# ---------- دیتابیس Postgres (فقط روی Vercel) ----------
# اگر این پر باشد، پروژه به‌جای فایل SQLite از Postgres استفاده می‌کند.
# روی Vercel این مقدار خودکار ساخته می‌شود؛ اینجا دست نزنید.
# POSTGRES_URL=postgresql://user:pass@host/dbname?sslmode=require

# روش دریافت پیام‌های تلگرام:
#   polling  = ساده‌ترین حالت، نیازی به آدرس عمومی برای ربات نیست (پیشنهاد می‌شود)
#   webhook  = سریع‌تر، ولی سرور باید آدرس https عمومی داشته باشد
BOT_MODE=polling

# فقط در حالت webhook لازم است (یک رشتهٔ تصادفی طولانی بسازید)
# ⚠️ تلگرام فقط این‌ها را قبول می‌کند: حروف انگلیسی، عدد، خط تیره (-) و زیرخط (_)
#    نقطه، فاصله، حرف فارسی و علائم دیگر باعث خطا می‌شوند.
WEBHOOK_SECRET=

# سرو کردن فایل‌های مینی‌اپ توسط همین سرور (1 = بله، 0 = خیر)
SERVE_WEBAPP=1

# ---------- پیامک (اختیاری — برای بعد) ----------
# تا وقتی SMS_PROVIDER خالی باشد، پیامکی فرستاده نمی‌شود.
#
# چرا مهم است؟ کدی که در تلگرام می‌آید به همان حسابی می‌رسد که در
# مینی‌اپ است، پس هر کسی می‌تواند شمارهٔ غریبه‌ای وارد کند و کد را
# خودش ببیند. با پیامک، کد به خودِ آن شماره می‌رود و واقعاً تأیید می‌شود.
#
# کاوه‌نگار:
#   SMS_PROVIDER=kavenegar
#   SMS_API_KEY=کلید-API
#   SMS_TEMPLATE=نام-الگوی-تأییدشده
#
# sms.ir:
#   SMS_PROVIDER=smsir
#   SMS_API_KEY=کلید-API
#   SMS_TEMPLATE=شناسهٔ-عددی-الگو
#   SMS_CODE_PARAM=CODE
#
# هر پنل دیگری:
#   SMS_PROVIDER=custom
#   SMS_BASE_URL=https://panel.example/send
#   SMS_BODY={"to":"{phone}","text":"کد شما: {code}"}
SMS_PROVIDER=

# در ثبت‌نام، کد تأیید به تلگرام کاربر فرستاده شود؟
#   1 = بله  (شماره ← کد ← نام)
#   0 = خیر  (شماره ← نام)   ← یک مرحله کمتر، معمولاً لید بیشتر
REQUIRE_PHONE_CODE=1

# ---------- ربات دوم برای پنل مدیریت (اختیاری) ----------
# اگر پنل CRM را روی یک ربات جدا باز می‌کنید، توکن آن ربات را اینجا
# بگذارید. تلگرام امضای ورود را با توکنِ همان رباتی می‌زند که مینی‌اپ
# از آن باز شده؛ بدون این مقدار، مدیر خطای ۴۰۱ می‌گیرد.
#
# اگر CRM را روی همان ربات اصلی باز می‌کنید، خالی بگذارید.
CRM_BOT_TOKEN=

# ---------- پرداخت کارت‌به‌کارت ----------
# تا وقتی درگاه پرداخت نداریم، مشتری مبلغ بسته را به این کارت واریز
# می‌کند و رسیدش را برای پشتیبانی می‌فرستد.
#
# اگر خالی بماند، مینی‌اپ به‌جای شمارهٔ کارت می‌گوید «برای پرداخت با
# پشتیبانی تماس بگیرید» — یعنی چیز غلطی به مشتری نشان داده نمی‌شود.
#
# ⚠️ شمارهٔ کارت را اینجا بگذارید، نه در web/assets/js/config.js —
#    آن فایل عمومی است و در مرورگر هر کسی خوانده می‌شود.
PAY_CARD_NUMBER=
PAY_CARD_HOLDER=
PAY_CARD_BANK=

# قیمت بسته‌ها در server/src/packages.js است، نه اینجا.

# ---------- ورود به پنل مدیریت از راه وب ----------
# برای باز کردن پنل در مرورگر لپ‌تاپ (بدون تلگرام):
#   https://<دامنهٔ شما>/admin
#
# تا وقتی این دو خالی باشند، ورود با رمز خاموش است و پنل فقط از
# داخل تلگرام باز می‌شود.
#
# ⚠️ رمز را بلند و غیرقابل‌حدس بگذارید — این پنل روی اینترنت باز است
#    و همهٔ سفارش‌ها و شماره‌های مشتریان پشت آن است.
ADMIN_USER=
ADMIN_PASSWORD=

# اختیاری. کلید امضای نشست‌ها. اگر خالی بماند از روی رمز ساخته می‌شود،
# یعنی با عوض کردن رمز، همهٔ نشست‌های باز هم بسته می‌شوند.
ADMIN_SESSION_SECRET=

# چند بار رمز غلط در ۱۰ دقیقه تحمل شود (پیش‌فرض ۲۰).
# موقع راه‌اندازی که ممکن است چند بار اشتباه بزنید، بالا نگهش دارید.
ADMIN_LOGIN_MAX_ATTEMPTS=

# برای مبالغ بزرگ، بانک‌ها کارت‌به‌کارت را قبول نمی‌کنند. از این مبلغ
# به بالا، به‌جای کارت شمارهٔ شبا نشان داده می‌شود.
PAY_SHEBA_NUMBER=
PAY_SHEBA_HOLDER=
PAY_SHEBA_BANK=
PAY_SHEBA_MIN_TOMAN=10000000

# ---------- سفارش‌های سایت likaads.com ----------
# سایت وردپرسی سفارش تلگرام‌ادز را از راه /api/website-lead می‌فرستد،
# نه از داخل تلگرام — پس امضای initData ندارد. این رمز مشترک به‌جایش
# بررسی می‌شود (سایت آن را در هدر X-Website-Secret می‌فرستد).
# یک رشتهٔ تصادفی طولانی بسازید و دقیقاً همان را در تنظیمات سایت
# وردپرسی (فایل inc/otp-leads.php) هم بگذارید.
# تا وقتی خالی باشد، این مسیر با خطا جواب می‌دهد و چیزی نمی‌شکند.
WEBSITE_API_SECRET=
